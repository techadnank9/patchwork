# ClickHouse Cloud (Connect button in the console shows these)
CLICKHOUSE_URL=https://YOUR-HOST.clickhouse.cloud:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Guild. Key comes from Triggers, New trigger, API in the web app. Shown once.
GUILD_KEY=api_key_id:api_key_secret
GUILD_WORKSPACE=owner/workspace
GUILD_TRIAGE_AGENT=owner~triage-agent
GUILD_PLANNER_AGENT=owner~planner-agent
GUILD_FIXER_AGENT=owner~fixer-agent

# guild = agents run on Guild (default). openai = emergency fallback only.
AGENT_BACKEND=guild
OPENAI_API_KEY=
OPENAI_MODEL=

# Web
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Limits
MAX_TRIAGE_PER_REPO=15
MAX_FIX_PER_REPO=5
TRIAGE_CONCURRENCY=4
SCAN_CONCURRENCY=2
